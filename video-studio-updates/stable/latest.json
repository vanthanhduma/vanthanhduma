7a4c","size":116},{"action":"replace","path":"updater/keys/update-public-key.pem","sha256":"ff130e6ce15fb7d64cca3e9cb84fea66bc41f2ec64f9e07abd0219b551fca9ce","size":116},{"action":"replace","path":"updater/qt_ui.py","sha256":"6f8353af435d1494e29d9610d314b93075548f863ed86a7592512c4e85d99dc9","size":11728},{"action":"replace","path":"updater/state.py","sha256":"8688e017fcd618f6f421036f2ef19e8bd298683f76182eb12a79c9e50d4e6874","size":1304},{"action":"replace","path":"MANIFEST.json","sha256":"7a78179ddf7886d62fd4c1f1c1497c7920a645cd5375ba70de0fa76d71ca4e28","size":29199}],"full_package":{"asset_name":"Goc_Review_Phim_Video_Studio_v1.5.9.25_FULL.zip","asset_sha256":"fd6d2df49891931c22d2747512b0e390961c2b91d96a93a2f9794b54f02bdbd3","asset_size":1492213,"asset_url":"https://raw.githubusercontent.com/vanthanhduma/vanthanhduma/main/video-studio-updates/stable/assets/Goc_Review_Phim_Video_Studio_v1.5.9.25_FULL.zip","manifest_name":"Goc_Review_Phim_Video_Studio_v1.5.9.25_FULL_MANIFEST.json","manifest_url":"https://raw.githubusercontent.com/vanthanhduma/vanthanhduma/main/video-studio-updates/stable/assets/Goc_Review_Phim_Video_Studio_v1.5.9.25_FULL_MANIFEST.json","package_type":"FULL"},"minimum_supported_version":"1.5.6.41","package_type":"UPDATE","published_at":"2026-11-22T03:07:26+00:00","release_notes":"# v1.5.9.25 — Export & QC Workspace Refinement\n\n## UI improvements\n- Reorganize Export & QC into clear groups: video preview/playback, manual cut ranges, timeline, output destination, export actions, and quality control.\n- Move the seek slider and timecode into the preview card.\n- Separate range entry, add/remove actions, source-range playback, short preview, and the manual cut table into one cut-management card.\n- Move the QC action and report into a dedicated quality-control group.\n- Add independent vertical scrolling to the center and inspector columns so controls remain accessible on shorter windows and different Windows DPI/font settings.\n- Improve spacing, card hierarchy, labels, and control sizing while preserving the existing Studio navy/teal theme.\n\n## Compatibility and behavior\n- Preserve all existing widget state names used by the rest of the application.\n- Preserve Engine commands and callbacks for full export, cut-range export, range preview, output-folder selection, QC, and stopping an export.\n- Preserve the existing manual-review behavior: selected ranges are excluded only when the user invokes cut-range export.\n- No changes to FFmpeg export settings, output codec, resolution, frame rate, or quality pipeline.\n\n## Regression coverage\n- Extend static layout tests for grouped preview/playback, responsive scroll columns, and separate output/QC cards.\n- Extend the Qt smoke test with 1650×900 geometry checks for card boundaries, range controls, and export buttons.\n","release_notes_url":"https://raw.githubusercontent.com/vanthanhduma/vanthanhduma/main/video-studio-updates/stable/RELEASE_NOTES_V1_5_9_25.md","schema_version":1,"supported_base_versions":["1.5.6.41","1.5.7.0","1.5.8.0","1.5.9.0","1.5.9.1","1.5.9.2","1.5.9.3","1.5.9.4","1.5.9.5","1.5.9.6","1.5.9.7","1.5.9.8","1.5.9.9","1.5.9.10","1.5.9.11","1.5.9.12","1.5.9.13","1.5.9.14","1.5.9.15","1.5.9.16","1.5.9.17","1.5.9.18","1.5.9.19","1.5.9.20","1.5.9.21","1.5.9.22","1.5.9.23","1.5.9.24"],"trust_mode":"https-sha256-v1","version":"1.5.9.25"}
